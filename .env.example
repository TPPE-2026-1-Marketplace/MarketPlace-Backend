PORT=3000
NODE_ENV=development

# Development with docker-compose.dev.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace123
POSTGRES_DB=marketplace_db

# Production with docker-compose.prod.yml
# POSTGRES_HOST=your-external-db-host
# POSTGRES_PORT=5432
# POSTGRES_USER=your-db-user
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_DB=your-db-name

# Payments Integration
PAYMENT_GATEWAY_PROVIDER=mock
INFINITEPAY_HANDLE=pabloserrapxx
INFINITEPAY_REDIRECT_URL=https://seusite.com/obrigado

# ImgBB - Obtenha sua chave em: https://api.imgbb.com/
IMGBB_API_KEY=sua_chave_api_aqui
# Shipping (módulo de frete)
LOJA_CEP_ORIGEM=70002900
