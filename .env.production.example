PORT=3000

POSTGRES_HOST=your-production-db-host
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

JWT_SECRET=replace-me-with-a-base64-secret

# Shipping (Melhor Envio) — em produção, usar https://www.melhorenvio.com.br
# e credenciais geradas no painel de produção (não no sandbox).
# Ver docs/melhor-envio-token.md para o fluxo de obtenção.
LOJA_CEP_ORIGEM=70002900
MELHOR_ENVIO_BASE_URL=https://www.melhorenvio.com.br
MELHOR_ENVIO_USER_AGENT=DK Fashion Backend (contato@dkfashion.com.br)
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REFRESH_TOKEN=
MELHOR_ENVIO_ACCESS_TOKEN=
