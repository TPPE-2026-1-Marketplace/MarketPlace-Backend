# ─────────────────────────────────────────────────────────────────────────────
# Ambiente de PRODUÇÃO. Copiado para .env.production por `make env-setup`.
# Use DATABASE_URL (Render/Neon) OU o conjunto POSTGRES_* abaixo.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000

# Recomendado para Render + Neon. Não commite a URL real.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ── Banco (obrigatório) ──────────────────────────────────────────────────────
POSTGRES_HOST=your-production-db-host
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# ── Auth (obrigatório) ───────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-base64-secret

# ─────────────────────────────────────────────────────────────────────────────
# Integrações externas (OPCIONAIS) — sem elas, a app usa mock/fallback.
# Em produção, preencha com credenciais reais (não as de sandbox/dev).
# ─────────────────────────────────────────────────────────────────────────────

# ── Pagamentos (InfinitePay) ─────────────────────────────────────────────────
PAYMENT_GATEWAY_PROVIDER=infinitepay
INFINITEPAY_HANDLE=
INFINITEPAY_REDIRECT_URL=
# OBRIGATÓRIO em produção: segredo compartilhado para autenticar o webhook
# (enviado pelo gateway no header x-webhook-secret). Sem ele, o webhook é recusado.
INFINITEPAY_WEBHOOK_SECRET=

# ── Imagens (ImgBB) ──────────────────────────────────────────────────────────
IMGBB_API_KEY=

# ── Frete (Melhor Envio — produção) ──────────────────────────────────────────
# Use https://www.melhorenvio.com.br e credenciais do painel de produção.
# Ver docs/melhor-envio-token.md para o fluxo de obtenção.
LOJA_CEP_ORIGEM=70002900
MELHOR_ENVIO_BASE_URL=https://www.melhorenvio.com.br
MELHOR_ENVIO_USER_AGENT=DK Fashion Backend (contato@dkfashion.com.br)
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REFRESH_TOKEN=
MELHOR_ENVIO_ACCESS_TOKEN=
# MELHOR_ENVIO_SERVICE_ID=1
