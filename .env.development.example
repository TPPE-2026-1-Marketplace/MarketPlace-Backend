PORT=3001

POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

JWT_SECRET=replace-me-with-a-base64-secret

# Shipping — CEP de origem da loja (8 dígitos, sem máscara). DF/Brasília.
LOJA_CEP_ORIGEM=70002900

# Melhor Envio (sandbox) — OAuth2 com fallback estático.
# Como obter as credenciais: ver docs/melhor-envio-token.md.
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_USER_AGENT=DK Fashion Backend (seuemail@dkfashion.com.br)

# OAuth2 (caminho principal). access_token expira em 30 dias e é renovado
# automaticamente via refresh_token. refresh_token não tem expiração documentada.
MELHOR_ENVIO_CLIENT_ID=cole-aqui-o-client-id
MELHOR_ENVIO_CLIENT_SECRET=cole-aqui-o-client-secret
MELHOR_ENVIO_REFRESH_TOKEN=cole-aqui-o-refresh-token

# Fallback estático: usado quando faltar config OAuth2 acima.
# Útil pra debug local sem precisar do fluxo completo.
MELHOR_ENVIO_ACCESS_TOKEN=cole-aqui-um-access-token-jwt-valido

# Opcional: ID do serviço (1=PAC, 2=SEDEX, 3=Jadlog .Package, ...).
# Omitido = mais barato entre cotações válidas.
# MELHOR_ENVIO_SERVICE_ID=1
